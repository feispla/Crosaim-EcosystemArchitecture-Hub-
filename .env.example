# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DISCORD INTEGRATION CONFIGURATION
# Discord Bot Token from Discord Developer Portal (Bot section)
DISCORD_BOT_TOKEN="MY_DISCORD_BOT_TOKEN"

# Discord Application ID
DISCORD_APPLICATION_ID="MY_DISCORD_APPLICATION_ID"

# Discord Client ID
DISCORD_CLIENT_ID="MY_DISCORD_CLIENT_ID"

# Discord Public Key for interactions
DISCORD_PUBLIC_KEY="MY_DISCORD_PUBLIC_KEY"

# Discord Client Secret
DISCORD_CLIENT_SECRET="MY_DISCORD_CLIENT_SECRET"

# Discord OAuth2 Redirect URI (Must match the Redirects registered in Discord Developer Portal)
# Development App: https://ais-dev-f2po5w7ntpgyehs6yse5sl-219686599777.us-east5.run.app/api/auth/discord/callback
# Shared App: https://ais-pre-f2po5w7ntpgyehs6yse5sl-219686599777.us-east5.run.app/api/auth/discord/callback
DISCORD_REDIRECT_URI="https://ais-dev-f2po5w7ntpgyehs6yse5sl-219686599777.us-east5.run.app/api/auth/discord/callback"

# Optional: Default Discord Channel ID for broadcasting recruitment signals
DISCORD_DEFAULT_CHANNEL_ID=""

# Optional: Discord Webhook URL for fallback or immediate notifications
DISCORD_WEBHOOK_URL=""

# SUPABASE DATA TIER CONFIGURATION
# Supabase Project URL (e.g., https://your-project.supabase.co)
SUPABASE_URL=""

# Supabase Public Anon Key (for client-side or public operations)
SUPABASE_ANON_KEY=""

# Supabase Service Role Key: Elevated backend secret with full database access (bypasses RLS).
# CRITICAL: NEVER expose this key to the frontend/browser. Only use in server-side code.
SUPABASE_SERVICE_ROLE_KEY=""
